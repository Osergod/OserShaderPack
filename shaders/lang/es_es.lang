screen.MOON_HALO=Halo

option.SUN_HALO_STRENGTH=Intensidad del halo
option.SUN_HALO_SIZE=Extensión del halo

option.MOON_HALO_STRENGTH=Intensidad del halo
option.MOON_HALO_SIZE=Extensión del halo

option.SUN_HALO_STRENGTH.comment=Controla el resplandor añadido por el shader. 0.0 lo desactiva, pero no elimina el que pueda estar dibujado en la textura.
option.MOON_HALO_STRENGTH.comment=Controla el resplandor añadido por el shader. También depende del brillo visible y de la fase lunar.

option.SUN_HALO_SIZE.comment=Extensión relativa al tamaño del Sol. No cambia el tamaño del propio astro.
option.MOON_HALO_SIZE.comment=Extensión relativa al tamaño de la Luna. No cambia el tamaño del propio astro.

# ========================================
# ILUMINACION DIRECTA
# ========================================

option.SUN_LIGHT_INTENSITY=Intensidad solar
option.MOON_LIGHT_INTENSITY=Intensidad lunar

option.SUN_LIGHT_INTENSITY.comment=Intensidad de la luz directa del Sol sobre las superficies. No modifica el brillo visible del astro.
option.MOON_LIGHT_INTENSITY.comment=Intensidad de la luz directa de la Luna sobre las superficies. No modifica el brillo visible del astro.

# ========================================
# COLORES DE LA ILUMINACION
# ========================================

screen.LIGHT_COLORS=Colores de la luz

option.LIGHT_FOLLOW_CELESTIAL_COLOR=Usar colores de los astros
option.LIGHT_COLOR_SATURATION=Saturación de la luz

option.LIGHT_FOLLOW_CELESTIAL_COLOR.comment=Activado: utiliza los colores del Sol y la Luna. Desactivado: utiliza los colores independientes de iluminación.
option.LIGHT_COLOR_SATURATION.comment=0.0 produce luz blanca. 1.0 conserva el color completo seleccionado.

screen.SUN_LIGHT_COLOR=Color solar independiente
screen.MOON_LIGHT_COLOR=Color lunar independiente

option.SUN_LIGHT_R=Rojo
option.SUN_LIGHT_G=Verde
option.SUN_LIGHT_B=Azul

option.MOON_LIGHT_R=Rojo
option.MOON_LIGHT_G=Verde
option.MOON_LIGHT_B=Azul

# ========================================
# LUZ AMBIENTAL Y DEL CIELO
# ========================================

screen.LIGHT_AMBIENT=Ambiente y cielo

option.AMBIENT_DAY=Ambiente de día
option.AMBIENT_NIGHT=Ambiente de noche

option.SKY_LIGHT_DAY=Cielo de día
option.SKY_LIGHT_NIGHT=Cielo de noche

option.AMBIENT_DAY.comment=Claridad mínima durante el día, incluso sin exposición al cielo.
option.AMBIENT_NIGHT.comment=Claridad mínima durante la noche, incluso sin exposición al cielo.

option.SKY_LIGHT_DAY.comment=Luz indirecta del cielo durante el día. Su contribución depende de la exposición de la superficie al exterior.
option.SKY_LIGHT_NIGHT.comment=Luz indirecta del cielo durante la noche. Su contribución depende de la exposición de la superficie al exterior.

# ========================================
# FASES LUNARES Y LLUVIA
# ========================================

screen.LIGHT_WEATHER=Fases lunares y lluvia

option.LIGHT_MOON_PHASE=Influencia de la fase lunar
option.LIGHT_RAIN_DIMMING=Reducir luz con lluvia
option.LIGHT_RAIN_REDUCTION=Reducción con lluvia máxima

option.LIGHT_MOON_PHASE.comment=La fase lunar modifica la intensidad de su luz directa. No cambia la luz ambiental mínima.
option.LIGHT_RAIN_DIMMING.comment=Permite que la lluvia reduzca la iluminación directa del Sol y de la Luna.
option.LIGHT_RAIN_REDUCTION.comment=Fracción de luz directa que se elimina con lluvia máxima. Solo se aplica si la reducción por lluvia está activada.

# ========================================
# SOMBRAS
# ========================================

option.SHADOWS_ENABLED=Sombras activadas
option.SHADOWS_ENABLED.comment=Activa las sombras solares y lunares. No genera sombras desde antorchas ni otras luces locales.

screen.SHADOW_QUALITY=Calidad y distancia
screen.SHADOW_APPEARANCE=Apariencia
screen.SHADOW_CASTERS=Objetos que proyectan sombra
screen.SHADOW_ADVANCED=Ajustes avanzados

# CALIDAD

option.shadowMapResolution=Resolución del mapa
option.shadowDistance=Distancia de las sombras

suffix.shadowMapResolution= px
suffix.shadowDistance= bloques

option.shadowMapResolution.comment=Tamaño de cada lado del mapa de sombras. Aumentarlo mejora el detalle, pero consume más recursos.
option.shadowDistance.comment=Distancia de referencia alrededor del jugador. Las sombras se desvanecen al acercarse al límite.

# APARIENCIA

option.SHADOW_SOFTENING=Suavizar bordes
option.SHADOW_SOFTNESS=Extensión del suavizado

suffix.SHADOW_SOFTNESS= texeles

option.SHADOW_STRENGTH=Bloqueo de luz directa
option.SHADOW_INDIRECT_DARKENING=Contraste adicional

option.SHADOW_SOFTENING.comment=Suaviza los bordes utilizando varias comparaciones de profundidad.
option.SHADOW_SOFTNESS.comment=Separación de las muestras del filtro, en texeles. Solo se aplica con el suavizado activado.

option.SHADOW_STRENGTH.comment=0.0 no bloquea luz directa. 1.0 aplica toda la sombra calculada. No reduce directamente la luz de antorchas.
option.SHADOW_INDIRECT_DARKENING.comment=Reduce ligeramente la luz indirecta del cielo en zonas con sombra. No modifica la luz ambiental mínima ni la luz de antorchas.

# OBJETOS

option.SHADOW_ENTITIES=Entidades y criaturas
option.SHADOW_BLOCK_ENTITIES=Bloques especiales

option.SHADOW_ENTITIES.comment=Permite que las entidades proyecten sombras. No implica que todas reciban nuestra iluminación mediante un programa propio.
option.SHADOW_BLOCK_ENTITIES.comment=Permite que elementos como los cofres participen en el mapa de sombras.

# AJUSTES AVANZADOS

option.SHADOW_BIAS=Margen de profundidad
option.SHADOW_BIAS.comment=Ayuda a evitar manchas de autosombreado. Un valor excesivo puede separar las sombras de los objetos.

# ========================================
# PERFILES DE CALIDAD
# ========================================

profile.RENDIMIENTO=Rendimiento
profile.RENDIMIENTO.comment=Sombras de terreno con menor resolución y distancia. Desactiva el suavizado y las sombras de entidades y bloques especiales.

profile.EQUILIBRADO=Equilibrado
profile.EQUILIBRADO.comment=Sombras a 2048 y 48 bloques, con suavizado y sombras de entidades y bloques especiales.

profile.CALIDAD=Calidad
profile.CALIDAD.comment=Sombras a 4096 y 64 bloques, con suavizado y sombras de entidades y bloques especiales. Mayor consumo de recursos.

# ========================================
# IMAGEN
# ========================================

screen.IMAGEN=Imagen

option.IMAGE_COLOR_CORRECTION=Corrección de color
option.IMAGE_COLOR_CORRECTION.comment=Activa los ajustes generales de color sobre la imagen final. No modifica los parametros de iluminacion del mundo.

option.IMAGE_SATURATION=Saturación
option.IMAGE_SATURATION.comment=Controla la intensidad de los colores. 0.0 muestra la imagen en gris y 1.0 conserva la saturacion original.

option.IMAGE_CONTRAST=Contraste
option.IMAGE_CONTRAST.comment=1.0 conserva el contraste original. Los valores superiores refuerzan la diferencia entre claros y oscuros.

option.IMAGE_WARMTH=Balance cálido y frío
option.IMAGE_WARMTH.comment=Los valores negativos producen tonos mas frios y los positivos tonos mas calidos. 0.0 conserva el balance original.

# ========================================
# EXPOSICION Y BRILLO
# ========================================

option.IMAGE_EXPOSURE=Exposición manual
suffix.IMAGE_EXPOSURE= EV
option.IMAGE_EXPOSURE.comment=Aclara u oscurece la imagen mediante pasos de exposicion. 0.0 conserva la entrada. No modifica la intensidad de las fuentes de luz.

option.IMAGE_BRIGHTNESS=Ajuste fino de brillo
option.IMAGE_BRIGHTNESS.comment=Suma o resta una pequeña cantidad al color final. 0.0 es neutro. Los valores positivos pueden aclarar los negros y los negativos pueden eliminar detalle en sombras.

# ========================================
# EFECTOS DE LENTE
# ========================================

screen.LENTE=Efectos de lente

# VINETA

screen.LENS_VIGNETTE_MENU=Viñeta

option.LENS_VIGNETTE=Viñeta activada
option.LENS_VIGNETTE.comment=Oscurece suavemente los bordes. Es un efecto de imagen, no una sombra del mundo.

option.LENS_VIGNETTE_STRENGTH=Intensidad
option.LENS_VIGNETTE_STRENGTH.comment=Cantidad de oscurecimiento de los bordes.

option.LENS_VIGNETTE_START=Inicio del efecto
option.LENS_VIGNETTE_START.comment=Los valores altos concentran el efecto cerca de las esquinas. Los bajos lo extienden hacia el centro.

# GRANO

screen.LENS_GRAIN_MENU=Grano

option.LENS_GRAIN=Grano activado
option.LENS_GRAIN.comment=Añade un ruido monocromatico que cambia con cada fotograma.

option.LENS_GRAIN_STRENGTH=Intensidad
option.LENS_GRAIN_STRENGTH.comment=Controla la visibilidad del grano. Los valores altos pueden resultar molestos.

# ABERRACION CROMATICA

screen.LENS_CHROMATIC_MENU=Aberración cromática

option.LENS_CHROMATIC=Aberración activada
option.LENS_CHROMATIC.comment=Separa ligeramente rojo y azul hacia los bordes, manteniendo el verde en su posicion.

option.LENS_CHROMATIC_STRENGTH=Separación de canales
suffix.LENS_CHROMATIC_STRENGTH= px
option.LENS_CHROMATIC_STRENGTH.comment=Desplazamiento maximo de cada canal respecto al verde, alcanzado en las esquinas.

# ENFOQUE

screen.LENS_SHARPENING_MENU=Enfoque

option.LENS_SHARPENING=Enfoque activado
option.LENS_SHARPENING.comment=Realza los detalles de la imagen. No es profundidad de campo ni desenfoque del fondo.

option.LENS_SHARPENING_STRENGTH=Intensidad
option.LENS_SHARPENING_STRENGTH.comment=Un valor moderado refuerza detalles. Los valores altos pueden crear halos y bordes artificiales.

